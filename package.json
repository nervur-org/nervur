{
  "name": "nervur",
  "version": "0.23.1-2",
  "description": "Nervur's kit of Quo: write beings and faculties, and open the house that holds them on any ground.",
  "keywords": [
    "quo",
    "protocol",
    "capability",
    "object-capability"
  ],
  "author": "Bookarest Digital SRL",
  "license": "Apache-2.0",
  "homepage": "https://nervur.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nervur-org/nervur.git"
  },
  "bugs": {
    "url": "https://github.com/nervur-org/nervur/issues"
  },
  "type": "module",
  "exports": {
    "./being": {
      "nervur-source": "./src/being/index.ts",
      "types": "./dist/being/index.d.ts",
      "default": "./dist/being/index.js"
    },
    "./bench": {
      "nervur-source": "./src/bench/index.ts",
      "types": "./dist/bench/index.d.ts",
      "default": "./dist/bench/index.js"
    },
    "./serve": {
      "nervur-source": "./src/serve/index.ts",
      "types": "./dist/serve/index.d.ts",
      "default": "./dist/serve/index.js"
    },
    ".": {
      "nervur-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "nervur-source": "./src/node/index.ts",
      "types": "./dist/node/index.d.ts",
      "default": "./dist/node/index.js"
    },
    "./edge": {
      "nervur-source": "./src/edge/index.ts",
      "types": "./dist/edge/index.d.ts",
      "default": "./dist/edge/index.js"
    },
    "./app": {
      "nervur-source": "./src/app/index.ts",
      "types": "./dist/app/index.d.ts",
      "default": "./dist/app/index.js"
    },
    "./browser": {
      "nervur-source": "./src/browser/index.ts",
      "types": "./dist/browser/index.d.ts",
      "default": "./dist/browser/index.js"
    },
    "./tsconfig.base.json": "./tsconfig.base.json"
  },
  "bin": {
    "nervur": "dist/node/cli.js",
    "nervur-test": "test.mjs"
  },
  "files": [
    "dist",
    "test.mjs",
    "source.mjs",
    "tsconfig.base.json",
    "AUTHORING.md",
    "COMMAND.md",
    "FACES.md",
    "FACULTIES.md",
    "GROUNDS.md",
    "KIT-SPEC.md",
    "NOTICE",
    "WORLD.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "check": "node quo.mjs && tsc -p tsconfig.json && tsc -p tsconfig.pure.json && NERVUR_TEST_COVER_LINES=95 NERVUR_TEST_COVER_BRANCHES=86 NERVUR_TEST_COVER_FUNCTIONS=90 node test.mjs \"test/**/*.test.ts\"",
    "mutate": "node mutate.mjs",
    "deep": "tsc -p deep && NERVUR_TEST_CAP=900000 node test.mjs \"deep/**/*.test.ts\"",
    "prepublishOnly": "test \"$NERVUR_GATED\" = 1 || { echo 'a publish is /release, from the root, on the human'\"'\"'s word' >&2; exit 1; }"
  },
  "engines": {
    "node": ">=22.18"
  },
  "quo": {
    "repository": "https://github.com/razvangherghina/quo",
    "commit": "993a01077c812bd0d9ca5c29ba52f6544e589ee0"
  },
  "dependencies": {
    "@noble/curves": "2.4.0",
    "@noble/post-quantum": "0.7.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "typescript": "^7.0.2"
  }
}
